# URL base de la API. Cuando el backend de FastAPI esté listo, solo
# cambia este valor (por ejemplo http://localhost:8000) y nada más
# del código necesita tocarse.
VITE_API_URL=http://localhost:8000

# "true" para servir todas las llamadas de red con MSW (Mock Service
# Worker). "false" para hablar con la API real en VITE_API_URL.
VITE_USAR_MOCKS=true
